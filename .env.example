# 复制为 .env 后按需修改，启动时用：npm run dev
# （npm run dev 用 node --env-file 加载；生产环境建议直接设系统环境变量）

# 服务端口
PORT=5173

# 监听地址。默认 0.0.0.0（所有网卡，可直接 IP:端口 访问）。
# 若用 Nginx 反代对外提供服务，改成 127.0.0.1 更安全：公网无法绕过 Nginx 直连
# HOST=127.0.0.1

# 是否信任 X-Forwarded-* 请求头（反代场景必须为 1，默认已是 1）
# TRUST_PROXY=1

# API Key 鉴权。配了就自动开启鉴权。
# 支持带名称： 客户A:key1,客户B:key2
# 也可以简单写： key1,key2
API_KEYS=dev-key-1234567890

# 设为 0 可关闭鉴权（仅建议内网自用）
# REQUIRE_AUTH=0

# 解析结果缓存时长（毫秒），默认 30 分钟
CACHE_TTL_MS=1800000

# 同时进行的解析任务数。浏览器是稀缺资源，建议 2~3
MAX_CONCURRENCY=2

# 单个解析任务的超时（毫秒）
PARSE_TIMEOUT_MS=45000

# 排队超时（毫秒），超过视为服务器繁忙
QUEUE_TIMEOUT_MS=90000

# download_url 的有效期（毫秒），默认 6 小时
DL_TTL_MS=21600000

# 下载链接签名密钥。不设会自动生成并保存到 .data/dl_secret
# 多实例部署时务必统一设置，否则各实例签发的链接互不通用
# DL_SECRET=your-long-random-secret

# 对外基址。反向代理场景建议显式配置，用于生成 download_url
# 不配置则从请求头推断（依赖 X-Forwarded-Proto / Host）
# PUBLIC_BASE_URL=https://api.example.com
