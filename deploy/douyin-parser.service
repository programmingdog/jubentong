[Unit]
Description=Douyin Share Link Parser Service
Documentation=file:///__APP_DIR__/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
Environment=NODE_ENV=production
# 浏览器内核的共享位置（服务用户读不到 root 的 ~/.cache）
Environment=PLAYWRIGHT_BROWSERS_PATH=__BROWSERS_PATH__

# 每次启动前确保 .data 存在。
# 没有这一步，ReadWritePaths 指向不存在的目录会让服务在 NAMESPACE 阶段就失败
# （status=226/NAMESPACE），进程根本起不来。
# 前缀 + 表示以 root 执行，避免服务用户无权在 APP_DIR 下建目录。
ExecStartPre=+/bin/mkdir -p __APP_DIR__/.data
ExecStartPre=+/bin/chown __USER__:__USER__ __APP_DIR__/.data

ExecStart=__NODE__ server/index.js

# 崩溃自动拉起
Restart=always
RestartSec=5
# 防止短时间反复重启打爆系统
StartLimitIntervalSec=60
StartLimitBurst=5

# 安全加固
# 注意：Chromium 的 crashpad 崩溃上报子进程在 NoNewPrivileges 限制下无法初始化，
# 会导致浏览器一启动就 SIGTRAP 退出。故这里不启用 NoNewPrivileges。
# NoNewPrivileges=true
PrivateTmp=true
# 用 full 而非 strict：strict 把根文件系统设为只读并限制 /proc，
# 会让 Chromium 启动阶段的辅助进程写库失败
ProtectSystem=full
ProtectHome=false
# Chromium 需要可写的 HOME 来放配置/缓存/崩溃库，否则 crashpad 初始化失败。
# 指向 .data（已在 ReadWritePaths 里，且服务用户有写权限）
Environment=HOME=__APP_DIR__/.data
ReadWritePaths=__APP_DIR__/.data

# 资源限制：浏览器较吃内存，可根据机器配置调整
MemoryMax=2G
TasksMax=512

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=douyin-parser

[Install]
WantedBy=multi-user.target
